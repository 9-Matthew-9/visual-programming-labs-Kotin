    {
        "id": "5f218c193bc43939",
        "type": "function",
        "z": "43a08a4179e3c863",
        "name": "function 6",
        "func": "const id = Number(msg.req.params.id);\n\nif (id === 1) {\n    msg.statusCode = 200;\n    msg.payload = {\n        id: 1,\n        name: \"Burger\"\n    };\n} else if (id === 2) {\n    msg.statusCode = 200;\n    msg.payload = {\n        id: 2,\n        name: \"Pizza\"\n    };\n} else {\n    msg.statusCode = 404;\n    msg.payload = {\n        error: \"Item not found\",\n        id: id\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 440,
