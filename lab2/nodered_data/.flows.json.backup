    {
        "id": "8db26173497d45eb",
        "type": "function",
        "z": "5c290adb386e97a4",
        "name": "function 2",
        "func": "const input = Number(msg.payload);\n\nlet result;\n\nif (input % 2 === 0) {\n    result = input;\n} else {\n    result = input + 1;\n}\n\nreturn {\n    payload: result,\n    topic: \"lab2/Kotin/switch\"\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
