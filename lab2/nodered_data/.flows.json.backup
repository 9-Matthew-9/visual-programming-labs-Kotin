    {
        "id": "420eabb648c928c1",
        "type": "function",
        "z": "5d991499dc532823",
        "name": "function 1",
        "func": "const input = Number(msg.payload);\n\nlet type;\n\nif (input % 2 === 0) {\n    type = \"even\";\n} else {\n    type = \"odd\";\n}\n\nconst numbers = [];\n\nfor (let i = 1; i <= input; i++) {\n    numbers.push(i);\n}\n\nconst result = {\n    student: \"Kotin\",\n    number: input,\n    type: type,\n    numbers: numbers\n};\n\nreturn {\n    payload: result,\n    topic: \"lab2/Kotin/function\"\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 240,
        "wires": [
            [
                "d4024a3fc0398723"
            ]
        ]
    },
