    "id": "fn12context",
    "type": "function",
    "z": "lab2-flow12",
    "name": "Flow context counter",
    "func": "let counter = flow.get(\"counter\") || 0;\n\nif (msg.action === \"increment\") {\n    counter += 1;\n    flow.set(\"counter\", counter);\n}\n\nmsg.payload = {\n    student: \"Kotin\",\n    contextType: \"flow context\",\n    counter: counter,\n    action: msg.action\n};\n\nreturn msg;",
